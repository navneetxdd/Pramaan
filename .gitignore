# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*

# Runtime storage (never commit evidence or signing keys)
.localdata/
uploads/
scratch/
tmp/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/
tsconfig.tsbuildinfo

# Legacy frontend tree (SPA lives at /src)
frontend/

# Tauri build output and frozen sidecars (built locally or in CI)
src-tauri/target/
src-tauri/binaries/pramaan-engine-*.exe
src-tauri/binaries/pramaan-engine-*.exe.sha256
artifacts/
release-artifacts/

# IDE / agent session artifacts
.idea/
.vscode/
.cursor/
.serena/
*.swp
.DS_Store
Thumbs.db
.p2_spec.txt
.walkthrough.json
*_spec.txt
scripts/_*_spec.txt

# Logs
*.log

# Reference / scratch trees
_ref-cybershield/
backend/

# Crypto material (defense in depth — .localdata/ already ignored)
*.pem
*.key

# Validation corpora — commit fixtures/manifest; ignore operator OEM dumps and downloads
validation_data/oem/*
!validation_data/oem/.gitkeep
validation_data/external/**/*.raw
validation_data/external/**/*.E01
validation_data/external/**/*.dd
validation_data/external/**/*.part
validation_data/external/**/*.zip
